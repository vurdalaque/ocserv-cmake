diff --git a/src/worker-http-proxy.c b/src/worker-http-proxy.c
new file mode 100644
index 0000000..ea0c6a5
--- /dev/null
+++ b/src/worker-http-proxy.c
@@ -0,0 +1,327 @@
+#include <curl/curl.h>
+#include <string.h>
+
+#include "worker.h"
+
+struct proxy_response_st {
+	worker_st *ws;
+	bool headers_complete;
+};
+
+static int response_502(worker_st *ws, unsigned int http_ver)
+{
+	if (cstp_printf(ws, "HTTP/1.%u 502 Bad Gateway\r\n", http_ver) < 0 ||
+	    cstp_puts(ws, "Content-Length: 0\r\n") < 0 ||
+	    cstp_puts(ws, "Connection: close\r\n\r\n") < 0)
+		return -1;
+	return 0;
+}
+
+static bool proxy_response_header_should_forward(const char *data, size_t length)
+{
+	static const char *const excluded[] = {
+		"Connection", "Content-Length", "Keep-Alive", "Transfer-Encoding"
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(excluded); i++) {
+		size_t name_length = strlen(excluded[i]);
+
+		if (length > name_length && data[name_length] == ':' &&
+		    strncasecmp(data, excluded[i], name_length) == 0)
+			return false;
+	}
+
+	return true;
+}
+
+static size_t proxy_response_header(char *data, size_t size, size_t nmemb,
+				    void *user_data)
+{
+	struct proxy_response_st *response = user_data;
+	size_t length = size * nmemb;
+
+	if (length == 0)
+		return 0;
+
+	if (length == 2 && data[0] == '\r' && data[1] == '\n') {
+		if (cstp_puts(response->ws, "Connection: close\r\n\r\n") < 0)
+			return 0;
+		response->headers_complete = true;
+		return length;
+	}
+
+	if (proxy_response_header_should_forward(data, length) &&
+	    cstp_send(response->ws, data, length) < 0)
+		return 0;
+
+	return length;
+}
+
+static size_t proxy_response_body(char *data, size_t size, size_t nmemb,
+				  void *user_data)
+{
+	struct proxy_response_st *response = user_data;
+	size_t length = size * nmemb;
+
+	if (!response->headers_complete ||
+	    cstp_send(response->ws, data, length) < 0)
+		return 0;
+
+	return length;
+}
+
+static struct curl_slist *proxy_append_header(struct curl_slist *headers,
+					      const char *header)
+{
+	struct curl_slist *new_headers = curl_slist_append(headers, header);
+
+	return new_headers;
+}
+
+static struct curl_slist *proxy_request_headers(worker_st *ws)
+{
+	struct curl_slist *headers = NULL;
+	const char *line = (const char *)ws->req.proxy_headers.data;
+	const char *end;
+	const char *next;
+	const char *limit = line + ws->req.proxy_headers.length;
+	char *header;
+	char *forwarded_for;
+	struct curl_slist *new_headers;
+
+	while (line < limit) {
+		end = memchr(line, '\n', limit - line);
+		next = end == NULL ? limit : end + 1;
+		if (end == NULL)
+			end = limit;
+		if (end > line && end[-1] == '\r')
+			end--;
+		if (end > line) {
+			header = talloc_size(ws, end - line + 1);
+			if (header == NULL)
+				goto error;
+			memcpy(header, line, end - line);
+			header[end - line] = 0;
+			new_headers = proxy_append_header(headers, header);
+			if (new_headers == NULL)
+				goto error;
+			headers = new_headers;
+		}
+		line = next;
+	}
+
+	forwarded_for = talloc_asprintf(ws, "X-Forwarded-For: %s",
+				       ws->remote_ip_str);
+	if (forwarded_for == NULL)
+		goto error;
+	new_headers = proxy_append_header(headers, forwarded_for);
+	if (new_headers == NULL)
+		goto error;
+	headers = new_headers;
+	new_headers = proxy_append_header(headers, "X-Forwarded-Proto: https");
+	if (new_headers == NULL)
+		goto error;
+	return new_headers;
+
+error:
+	curl_slist_free_all(headers);
+	return NULL;
+}
+
+static bool header_name_equals(const char *line, size_t length, const char *name)
+{
+	size_t name_length = strlen(name);
+
+	return length > name_length && line[name_length] == ':' &&
+	       strncasecmp(line, name, name_length) == 0;
+}
+
+static bool value_contains_case(const char *value, size_t value_length,
+				const char *needle)
+{
+	size_t needle_length = strlen(needle);
+	size_t i;
+
+	if (needle_length > value_length)
+		return false;
+
+	for (i = 0; i <= value_length - needle_length; i++) {
+		if (strncasecmp(value + i, needle, needle_length) == 0)
+			return true;
+	}
+
+	return false;
+}
+
+static bool request_header_contains(worker_st *ws, const char *name,
+				    const char *needle)
+{
+	const char *line = (const char *)ws->req.proxy_headers.data;
+	const char *limit = line + ws->req.proxy_headers.length;
+	const char *end;
+	const char *value;
+
+	while (line < limit) {
+		end = memchr(line, '\n', limit - line);
+		if (end == NULL)
+			end = limit;
+		if (header_name_equals(line, end - line, name)) {
+			value = line + strlen(name) + 1;
+			while (value < end && (*value == ' ' || *value == '\t'))
+				value++;
+			if (value_contains_case(value, end - value, needle))
+				return true;
+		}
+		line = end < limit ? end + 1 : limit;
+	}
+
+	return false;
+}
+
+static bool request_has_vpn_markers(worker_st *ws)
+{
+	const char *line = (const char *)ws->req.proxy_headers.data;
+	const char *limit = line + ws->req.proxy_headers.length;
+	const char *end;
+
+	while (line < limit) {
+		end = memchr(line, '\n', limit - line);
+		if (end == NULL)
+			end = limit;
+		if ((end - line > sizeof("X-CSTP-") - 1 &&
+		     strncasecmp(line, "X-CSTP-", sizeof("X-CSTP-") - 1) == 0) ||
+		    (end - line > sizeof("X-DTLS-") - 1 &&
+		     strncasecmp(line, "X-DTLS-", sizeof("X-DTLS-") - 1) == 0) ||
+		    (end - line > sizeof("X-AnyConnect-") - 1 &&
+		     strncasecmp(line, "X-AnyConnect-",
+				 sizeof("X-AnyConnect-") - 1) == 0) ||
+		    header_name_equals(line, end - line, "X-Support-HTTP-Auth"))
+			return true;
+		if (header_name_equals(line, end - line, "Cookie")) {
+			const char *value = line + sizeof("Cookie");
+
+			if (value_contains_case(value, end - value, "webvpn=") ||
+			    value_contains_case(value, end - value, "webvpncontext=") ||
+			    value_contains_case(value, end - value, "webvpnlogin="))
+				return true;
+		}
+		line = end < limit ? end + 1 : limit;
+	}
+
+	return request_header_contains(ws, "User-Agent", "OpenConnect") ||
+	       request_header_contains(ws, "User-Agent", "AnyConnect");
+}
+
+static enum http_route_decision route_decision(worker_st *ws,
+						enum llhttp_method method)
+{
+	if (method == HTTP_CONNECT)
+		return HTTP_ROUTE_OCSERV;
+
+	if (method == HTTP_GET && strcmp(ws->req.url, "/") == 0) {
+		if (WSRCONFIG(ws)->browser_redirect_url != NULL &&
+		    request_header_contains(ws, "Accept", "text/html") &&
+		    !request_has_vpn_markers(ws))
+			return HTTP_ROUTE_UPSTREAM;
+		return HTTP_ROUTE_OCSERV;
+	}
+
+	if (http_url_is_known(ws, ws->req.url))
+		return HTTP_ROUTE_OCSERV;
+
+	if (WSRCONFIG(ws)->browser_redirect_url == NULL)
+		return method == HTTP_POST ? HTTP_ROUTE_OCSERV : HTTP_ROUTE_REJECT;
+
+	switch (method) {
+	case HTTP_GET:
+	case HTTP_POST:
+	case HTTP_HEAD:
+	case HTTP_OPTIONS:
+		return HTTP_ROUTE_UPSTREAM;
+	default:
+		return HTTP_ROUTE_REJECT;
+	}
+}
+
+enum http_route_decision http_route_request(worker_st *ws,
+					    enum llhttp_method method)
+{
+	enum http_route_decision decision = route_decision(ws, method);
+
+	oclog(ws, LOG_INFO,
+	      "browser_redirect route=%s method=%s path=%s",
+	      decision == HTTP_ROUTE_OCSERV ? "ocserv" :
+	      decision == HTTP_ROUTE_UPSTREAM ? "upstream" : "reject",
+	      llhttp_method_name(method), ws->req.url);
+	return decision;
+}
+
+int proxy_fallback_handler(worker_st *ws, unsigned int http_ver, const char *method)
+{
+	CURL *curl;
+	CURLcode result;
+	struct curl_slist *headers;
+	struct proxy_response_st response = { .ws = ws };
+	char *url;
+	static bool curl_initialized;
+
+	if (!curl_initialized && curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK)
+		return response_502(ws, http_ver);
+	curl_initialized = true;
+
+	url = talloc_asprintf(ws, "%s%s", WSRCONFIG(ws)->browser_redirect_url,
+			      ws->req.url);
+	if (url == NULL)
+		return response_502(ws, http_ver);
+
+	headers = proxy_request_headers(ws);
+	if (headers == NULL)
+		return response_502(ws, http_ver);
+
+	curl = curl_easy_init();
+	if (curl == NULL) {
+		curl_slist_free_all(headers);
+		return response_502(ws, http_ver);
+	}
+
+	curl_easy_setopt(curl, CURLOPT_URL, url);
+	curl_easy_setopt(curl, CURLOPT_HTTP_VERSION, CURL_HTTP_VERSION_1_1);
+	curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, method);
+	curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+	curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 10L);
+	curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);
+	curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+	curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 1L);
+	curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 2L);
+	curl_easy_setopt(curl, CURLOPT_HEADERFUNCTION, proxy_response_header);
+	curl_easy_setopt(curl, CURLOPT_HEADERDATA, &response);
+	curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, proxy_response_body);
+	curl_easy_setopt(curl, CURLOPT_WRITEDATA, &response);
+
+	if (strcmp(method, "POST") == 0) {
+		curl_easy_setopt(curl, CURLOPT_POSTFIELDS,
+				 ws->req.body == NULL ? "" : ws->req.body);
+		curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE, ws->req.body_length);
+	} else if (strcmp(method, "HEAD") == 0) {
+		curl_easy_setopt(curl, CURLOPT_NOBODY, 1L);
+	}
+
+	result = curl_easy_perform(curl);
+	curl_easy_cleanup(curl);
+	curl_slist_free_all(headers);
+
+	if (result != CURLE_OK) {
+		oclog(ws, LOG_INFO,
+		      "browser_redirect upstream_result=error method=%s path=%s error=%s",
+		      method, ws->req.url, curl_easy_strerror(result));
+		if (!response.headers_complete)
+			return response_502(ws, http_ver);
+		return -1;
+	}
+
+	oclog(ws, LOG_INFO,
+	      "browser_redirect upstream_result=ok method=%s path=%s",
+	      method, ws->req.url);
+	return response.headers_complete ? 0 : response_502(ws, http_ver);
+}
