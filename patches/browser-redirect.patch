+static bool header_accepts_html(const char *value)
+{
+	const char *p = value;
+
+	while ((p = strcasestr(p, "text/html")) != NULL) {
+		if ((p == value || p[-1] == ',' ||
+		     isspace((unsigned char)p[-1])) &&
+		    (p[9] == 0 || p[9] == ',' || p[9] == ';' ||
+		     isspace((unsigned char)p[9])))
+			return true;
+		p += 9;
+	}
+
+	return false;
+}
