+int http_url_is_known(worker_st *ws, const char *url)
+{
+	const struct known_urls_st *p;
+	unsigned int len = strlen(url);
+	unsigned int i;
+
+	for (p = known_urls; p->url != NULL; p++) {
+		if ((len == p->url_size && strcmp(p->url, url) == 0) ||
+		    (len >= p->url_size &&
+		     strncmp(p->url, url, p->url_size) == 0 &&
+		     (p->partial_match != 0 || url[p->url_size] == '/' ||
+		      url[p->url_size] == '?')))
+			return 1;
+	}
+
+	for (i = 0; i < WSRCONFIG(ws)->n_kkdcp; i++) {
+		if (WSRCONFIG(ws)->kkdcp[i]->url &&
+		    strcmp(WSRCONFIG(ws)->kkdcp[i]->url, url) == 0)
