+struct proxy_response_st {
+	worker_st *ws;
+	unsigned int http_ver;
+	bool headers_complete;
+};
+
+static int response_502(worker_st *ws, unsigned int http_ver)
+{
+	if (cstp_printf(ws, "HTTP/1.%u 502 Bad Gateway\r\n", http_ver) < 0 ||
+	    cstp_puts(ws, "Content-Length: 0\r\n") < 0 ||
+	    cstp_puts(ws, "Connection: close\r\n\r\n") < 0)
+		return -1;
+	return 0;
+}
+
+static bool proxy_response_header_should_forward(const char *data, size_t length)
+{
+	static const char *const excluded[] = {
+		"Connection", "Content-Length", "Keep-Alive", "Transfer-Encoding"
+	};
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(excluded); i++) {
+		size_t name_length = strlen(excluded[i]);
+
+		if (length > name_length && data[name_length] == ':' &&
+		    strncasecmp(data, excluded[i], name_length) == 0)
+			return false;
+	}
+
+	return true;
+}
+
+static size_t proxy_response_header(char *data, size_t size, size_t nmemb,
+				    void *user_data)
+{
+	struct proxy_response_st *response = user_data;
+	size_t length = size * nmemb;
+
+	if (length == 0)
+		return 0;
+
+	if (length == 2 && data[0] == '\r' && data[1] == '\n') {
+		if (cstp_puts(response->ws, "Connection: close\r\n\r\n") < 0)
+			return 0;
+		response->headers_complete = true;
+		return length;
+	}
+
+	if (proxy_response_header_should_forward(data, length) &&
+	    cstp_send(response->ws, data, length) < 0)
+		return 0;
+
+	return length;
+}
+
+static size_t proxy_response_body(char *data, size_t size, size_t nmemb,
+				  void *user_data)
+{
+	struct proxy_response_st *response = user_data;
+	size_t length = size * nmemb;
+
+	if (!response->headers_complete ||
+	    cstp_send(response->ws, data, length) < 0)
+		return 0;
+
+	return length;
+}
+
+static struct curl_slist *proxy_request_headers(worker_st *ws)
+{
+	struct curl_slist *headers = NULL;
+	const char *line = (const char *)ws->req.proxy_headers.data;
+	const char *end;
+	const char *next;
+	const char *limit = line + ws->req.proxy_headers.length;
+	char *header;
+	char *forwarded_for;
+
+	while (line < limit) {
+		end = memchr(line, '\n', limit - line);
+		next = end == NULL ? limit : end + 1;
+		if (end == NULL)
+			end = limit;
+		if (end > line && end[-1] == '\r')
+			end--;
+		if (end > line) {
+			header = talloc_size(ws, end - line + 1);
+			if (header == NULL)
+				goto error;
+			memcpy(header, line, end - line);
+			header[end - line] = 0;
+			headers = curl_slist_append(headers, header);
+			if (headers == NULL)
+				goto error;
+		}
+		line = next;
+	}
+
+	forwarded_for = talloc_asprintf(ws, "X-Forwarded-For: %s",
+				       ws->remote_ip_str);
+	if (forwarded_for == NULL)
+		goto error;
+	headers = curl_slist_append(headers, forwarded_for);
+	if (headers == NULL)
+		goto error;
+	headers = curl_slist_append(headers, "X-Forwarded-Proto: https");
+	if (headers == NULL)
+		goto error;
+	return headers;
+
+error:
+	curl_slist_free_all(headers);
+	return NULL;
+}
+
+int proxy_fallback_handler(worker_st *ws, unsigned int http_ver, const char *method)
+{
+	CURL *curl;
+	CURLcode result;
+	struct curl_slist *headers;
+	struct proxy_response_st response = { .ws = ws, .http_ver = http_ver };
+	char *url;
+	static bool curl_initialized;
+
+	if (!curl_initialized && curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK)
+		return response_502(ws, http_ver);
+	curl_initialized = true;
+
+	url = talloc_asprintf(ws, "%s%s", WSRCONFIG(ws)->browser_redirect_url,
+			      ws->req.url);
+	if (url == NULL)
+		return response_502(ws, http_ver);
+
+	headers = proxy_request_headers(ws);
+	if (headers == NULL)
+		return response_502(ws, http_ver);
+
+	curl = curl_easy_init();
+	if (curl == NULL) {
+		curl_slist_free_all(headers);
+		return response_502(ws, http_ver);
+	}
+
+	curl_easy_setopt(curl, CURLOPT_URL, url);
+	curl_easy_setopt(curl, CURLOPT_HTTP_VERSION, CURL_HTTP_VERSION_1_1);
+	curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, method);
+	curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
+	curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 10L);
+	curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 0L);
+	curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
+	curl_easy_setopt(curl, CURLOPT_SSL_VERIFYPEER, 1L);
+	curl_easy_setopt(curl, CURLOPT_SSL_VERIFYHOST, 2L);
+	curl_easy_setopt(curl, CURLOPT_HEADERFUNCTION, proxy_response_header);
+	curl_easy_setopt(curl, CURLOPT_HEADERDATA, &response);
+	curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, proxy_response_body);
+	curl_easy_setopt(curl, CURLOPT_WRITEDATA, &response);
+
+	if (strcmp(method, "POST") == 0) {
+		curl_easy_setopt(curl, CURLOPT_POSTFIELDS, ws->req.body);
+		curl_easy_setopt(curl, CURLOPT_POSTFIELDSIZE,
+				 ws->req.body_length);
+	}
+
+	oclog(ws, LOG_INFO, "proxying %s %s", method, ws->req.url);
+	result = curl_easy_perform(curl);
+	curl_easy_cleanup(curl);
+	curl_slist_free_all(headers);
+
+	if (result != CURLE_OK) {
+		oclog(ws, LOG_INFO, "proxy failed for %s: %s", ws->req.url,
+		      curl_easy_strerror(result));
+		if (!response.headers_complete)
+			return response_502(ws, http_ver);
+		return -1;
+	}
+
+	return response.headers_complete ? 0 : response_502(ws, http_ver);
+}
