+static bool valid_browser_redirect_url(const char *url)
+{
+	const unsigned char *p;
+
+	if (strncmp(url, "https://", 8) != 0 || url[8] == 0 ||
+	    strchr("/?#", url[8]) != NULL)
+		return false;
+
+	for (p = (const unsigned char *)url; *p != 0; p++) {
+		if (iscntrl(*p) || isspace(*p))
+			return false;
+	}
+
+	return true;
+}
